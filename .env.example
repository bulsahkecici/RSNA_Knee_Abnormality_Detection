# Local LM Studio (OpenAI-compatible). This is NOT OpenAI cloud.
RSNA_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
RSNA_LMSTUDIO_API_KEY=
# Exact /v1/models id. Do not use a Hugging Face path as the API model id.
# Preferred local id observed on this machine: qwen/qwen3.8-27b
RSNA_LMSTUDIO_MODEL_ID=qwen/qwen3.8-27b

# Kaggle CLI uses ~/.kaggle/kaggle.json by default. Do not commit it.
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Optional Google Drive sync folder used as transport, not as a live SQLite mount.
# RSNA_DRIVE_SYNC_DIR=

# Optional Colab/Kaggle notebook identity after a verified handshake.
# RSNA_COLAB_LEASE_ID=
# RSNA_KAGGLE_KERNEL=

# Never log these values.
RSNA_LOG_SECRETS=0
